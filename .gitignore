# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
backend/data/*.db
backend/data/*.db-*
backend/data/*.db.backup*

# Node
node_modules/
frontend/dist/
*.tsbuildinfo
.vite/

# Data caches (large rasters / ephemeris caches are regenerated)
data/cache/
data/raw/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
