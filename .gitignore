# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
backend/data/*.db
backend/data/*.db-*
backend/data/*.db.backup*

# Node
node_modules/
frontend/dist/
*.tsbuildinfo
.vite/

# Data caches (large rasters / ephemeris caches are regenerated)
data/cache/
data/raw/
backend/data/cache/
backend/data/raw/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# NASA SVS 14959 Moon GLBs (13.8 MB / 81.5 MB) — installed by `npm run fetch:moon [-- --high]`, verified by SHA-256
frontend/public/nasa/svs-14959/*.glb
frontend/public/nasa/svs-14959/*.part*
frontend/public/nasa/svs-14959/*.tmp
