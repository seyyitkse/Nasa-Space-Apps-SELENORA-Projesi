# SELENORA backend configuration — copy to `.env` and fill in values.
# Never commit `.env`. Never put these values in the frontend.

SELENORA_ENVIRONMENT=development
SELENORA_LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins (no wildcards in production)
SELENORA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SELENORA_DATABASE_URL=sqlite:///./data/selenora.db
SELENORA_RATE_LIMIT_PER_MINUTE=120

# NASA / JPL Horizons
SELENORA_HORIZONS_BASE_URL=https://ssd.jpl.nasa.gov/api/horizons.api
SELENORA_HORIZONS_TIMEOUT_SECONDS=30
SELENORA_HORIZONS_MAX_RETRIES=3

# DeepSeek (AI explanation layer only — never computes scientific results)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
